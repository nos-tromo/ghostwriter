# ghostwriter — example configuration
#
# deploy's `make env` writes .env from this file and keeps it in step
# (by hand: cp .env.example .env).
#
#   KEY=value     set per host
#   # KEY=value   optional; the value shown is the default
#
# Tags, on the line above a setting:
#   [required]          must be set on every host
#   [secret]            never printed; your value never follows the example
#   [shared: M [KEY]]   same value as member M (its KEY); make env fills it
#   [dev]               read only by the dev overlay (make up-dev)


# =============================================================================
# Required
# =============================================================================

# API key for the inference router. Must equal the router's master key (the
# OPENAI_API_KEY in vllm-service's .env). docker/compose.yaml falls back to
# `dummy`, which suits servers that do not enforce auth.
# [required] [secret] [shared: vllm-service]
OPENAI_API_KEY=

# =============================================================================
# Auth & identity
# =============================================================================

# Edge secret: the edge gateway sends it in X-Edge-Secret, and once set the
# backend trusts X-Auth-User only on requests carrying it. At least 32
# characters, or the backend does not start; edge-plane needs the same value
# in its own .env, and make env generates it. Unset is the dev fallback,
# which trusts the identity headers from any caller.
# [secret] [shared: edge-plane]
# GHOSTWRITER_EDGE_SECRET=

# =============================================================================
# Network & proxy
# =============================================================================

# Name of the external network between the app backends and vllm-service.
# Created via `make network`. Override only if you renamed it.
# INFERENCE_NETWORK=inference-net

# Name of the external network the frontend joins, where the edge-plane
# gateway reaches it as `ghostwriter-frontend`. Override only if you renamed
# it.
# EDGE_NET=edge-net

# Name of the external network the backend joins to reach workbench, as
# `ghostwriter-backend`. Override only if you renamed it.
# WORKBENCH_NET=workbench-net

# Proxy bypass: comma-separated extra hostnames appended to NO_PROXY/no_proxy.
# Must start with a leading comma, for example
#   EXTRA_NO_PROXY=,ollama,vllm-router
# EXTRA_NO_PROXY=

# =============================================================================
# Inference
# =============================================================================

# The provider behind the endpoint: vllm, ollama, openai or another; it must
# match the endpoint. On vllm Ghostwriter sets the chat template's thinking
# to the composer's reasoning switch.
# INFERENCE_PROVIDER=vllm

# Base URL of the OpenAI-compatible endpoint, including /v1. The default is
# the router on inference-net; point it elsewhere, with INFERENCE_PROVIDER to
# match, to change provider.
# OPENAI_API_BASE=http://vllm-router:4000/v1

# The chat model, passed in every chat-completions request.
# TEXT_MODEL=Qwen/Qwen3.8-27B-FP8

# The chat model's context in tokens: CHAT_MAX_MODEL_LEN in vllm-service's
# .env. Each round's prompt budget follows from it; under 22000 stops
# startup.
# GHOSTWRITER_CONTEXT_TOKENS=40000

# Pictures: on lets users attach images, which go to the chat model with
# their message, and shows the model pages that have no text. Off, a model
# without vision, or a workbench before 0.7.0 behaves as before. On Ollama
# the model's capabilities are read once at start, and pictures go off
# unless it lists vision.
# GHOSTWRITER_VISION=on

# The most images one request carries; at most vllm-service's
# CHAT_LIMIT_MM_PER_PROMPT.
# GHOSTWRITER_MAX_IMAGES=8

# Tokens one image costs the model. Unset: one per 32x32 pixels (Qwen). A
# number: a fixed cost per image (280 for gemma); pages then go as two
# strips.
# GHOSTWRITER_IMAGE_CONTEXT_TOKENS=

# The speech-to-text model for dictation.
# WHISPER_MODEL=openai/whisper-large-v3

# =============================================================================
# ghostwriter
# =============================================================================

# UI language of the SPA (uniform federation var; en|de). An unknown value
# falls back to en.
# RESPONSE_LANGUAGE=en

# Dictation through the router's speech-to-text: on or off.
# GHOSTWRITER_SPEECH_INPUT=on

# --- workbench ---

# workbench processes attached documents and runs the chat's tools. The key
# is the same value as GHOSTWRITER_WORKBENCH_KEY in workbench's .env; make
# env fills it in. Unset, tools and attachments are off and plain chat
# works; a key under 32 characters stops startup.
# [secret] [shared: workbench GHOSTWRITER_WORKBENCH_KEY]
# WORKBENCH_API_KEY=

# workbench's base URL on workbench-net.
# WORKBENCH_API_BASE=http://workbench-api:8000

# The longest one tool call may take, in seconds.
# WORKBENCH_TIMEOUT=150

# =============================================================================
# Audit & retention
# =============================================================================

# Comma-separated audit actions that need a stated purpose (X-Audit-Purpose,
# sent from the SPA's purpose bar); such a request without one gets 428.
# Empty requires none. An unknown action stops startup. AUDIT_OUTPUT is set
# by docker/compose.yaml.
# AUDIT_REQUIRE_PURPOSE=

# Days a chat is kept after it was started. `off` keeps chats, for
# development only.
# GHOSTWRITER_CHAT_RETENTION_DAYS=90

# Days a new or shorter chat period waits before it deletes anything.
# RETENTION_NOTICE_DAYS=30

# Days workbench keeps a chat's files; tool results and table previews are
# emptied after the same period. Must equal workbench's own value.
# [shared: workbench]
# WORKBENCH_RETENTION_DAYS=7

# =============================================================================
# Development only
# =============================================================================

# Fallback account for requests without a trusted X-Auth-User, which get 401
# otherwise. The dev overlay (make dev / make up-dev) sets it to `dev`; set
# it here to pick another invented account or for a local run without
# Docker. Ignored while GHOSTWRITER_EDGE_SECRET is set. Leave unset in
# production.
# [dev]
# GHOSTWRITER_DEFAULT_IDENTITY=dev

# Host ports of the dev overlay (make up-dev).
# [dev]
# GHOSTWRITER_FRONTEND_HOST_PORT=8504
# [dev]
# GHOSTWRITER_BACKEND_HOST_PORT=8004
